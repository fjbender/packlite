# PackLite - Environment Variables Example
# Copy this file to .env.local for development or .env for production

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-secret-key

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/packlite

# When deployed with Docker, this will be overridden to:
# MONGODB_URI=mongodb://mongodb:27017/packlite