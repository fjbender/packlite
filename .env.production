# Production environment settings for PackLite
# Values defined here will be used when NODE_ENV=production

# Do not store sensitive values in this file
# Set them as environment variables on the server or in Docker Compose

# Next Auth URL must match your production domain
NEXTAUTH_URL=http://localhost
# JWT Secret - set this to a strong random value in production
# NEXTAUTH_SECRET should be set in Docker Compose

# MongoDB connection - this will be overridden by the value in docker-compose.yml
MONGODB_URI=mongodb://mongodb:27017/packlite